{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finnjclancy/open-neurodata-to-cnd/schemas/plan.schema.json",
  "title": "Open Neurodata to CND corpus plan",
  "type": "object",
  "required": [
    "plan_version",
    "corpus_id",
    "corpus_version",
    "generated_at",
    "source",
    "recording_count",
    "source_bytes",
    "pilot_recording_ids",
    "jobs"
  ],
  "properties": {
    "plan_version": {"const": "1.0.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "recording_count": {"type": "integer", "minimum": 1},
    "source_bytes": {"type": "integer", "minimum": 1},
    "template_recipe": {"type": "string", "minLength": 1},
    "template_recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "pilot_recording_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": [
        "dataset_id",
        "provider",
        "version",
        "url",
        "inventory_url",
        "inventory_canonical_sha256"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": ["string", "null"]},
        "inventory_url": {"type": "string", "format": "uri"},
        "inventory_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recording_id",
          "subject",
          "task",
          "primary_path",
          "source_bytes",
          "expected",
          "participant",
          "files"
        ],
        "properties": {
          "recording_id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "primary_path": {"type": "string", "minLength": 1},
          "source_bytes": {"type": "integer", "minimum": 1},
          "template_recipe": {"type": "string", "minLength": 1},
          "template_recipe_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "participant": {"type": "object"},
          "expected": {
            "type": "object",
            "required": [
              "channels",
              "sampling_frequency_hz",
              "duration_seconds"
            ],
            "properties": {
              "channels": {"type": "integer", "minimum": 1},
              "sampling_frequency_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "url",
                "size_bytes",
                "checksum_algorithm",
                "checksum"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri"},
                "size_bytes": {"type": "integer", "minimum": 1},
                "checksum_algorithm": {"enum": ["sha256", "git"]},
                "checksum": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {"required": ["template_recipe"]},
            "then": {"required": ["template_recipe_sha256"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
