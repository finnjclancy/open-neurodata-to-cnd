{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finnjclancy/open-neurodata-to-cnd/schemas/dataset.schema.json",
  "title": "Open Neurodata to CND catalogue",
  "type": "object",
  "required": ["catalog_version", "reviewed_at", "datasets"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "provider",
          "modalities",
          "access",
          "license",
          "priority",
          "status",
          "scale",
          "tags"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "provider": {"type": "string", "minLength": 1},
          "modalities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "access": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "minLength": 1},
          "scale": {"type": "object"},
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
