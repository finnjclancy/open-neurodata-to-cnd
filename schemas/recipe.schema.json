{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finnjclancy/open-neurodata-to-cnd/schemas/recipe.schema.json",
  "title": "Open Neurodata to CND conversion recipe",
  "type": "object",
  "required": [
    "recipe_id",
    "recipe_version",
    "status",
    "source",
    "selection",
    "trials",
    "features",
    "synchronization",
    "output",
    "validation",
    "license"
  ],
  "properties": {
    "recipe_id": {"type": "string", "minLength": 1},
    "recipe_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "active", "deprecated"]},
    "source": {
      "type": "object",
      "required": ["dataset_id", "provider", "url", "require_pinned_version_before_conversion"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "version": {"type": ["string", "null"]},
        "require_pinned_version_before_conversion": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "selection": {"type": "object"},
    "trials": {"type": "object"},
    "features": {"type": "array", "items": {"type": "object"}},
    "synchronization": {"type": "object"},
    "output": {"type": "object"},
    "validation": {"type": "object"},
    "license": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
