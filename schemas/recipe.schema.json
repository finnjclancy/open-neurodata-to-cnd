{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finnjclancy/open-neurodata-to-cnd/schemas/recipe.schema.json",
  "title": "Open Neurodata to CND conversion recipe",
  "type": "object",
  "required": [
    "recipe_id",
    "recipe_version",
    "status",
    "source",
    "selection",
    "trials",
    "features",
    "synchronization",
    "output",
    "validation",
    "license"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "recipe_id": {"type": "string", "minLength": 1},
    "recipe_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "active", "deprecated"]},
    "source": {
      "type": "object",
      "required": ["dataset_id", "provider", "url", "require_pinned_version_before_conversion"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "version": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "file_url": {"type": "string", "format": "uri"},
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "primary_path": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "url"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "checksum_algorithm": {"enum": ["sha256", "git"]},
              "checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}
            },
            "anyOf": [
              {"required": ["sha256"]},
              {"required": ["checksum_algorithm", "checksum"]}
            ],
            "additionalProperties": false
          }
        },
        "require_pinned_version_before_conversion": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "selection": {"type": "object"},
    "trials": {"type": "object"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source_annotation": {"type": "string", "minLength": 1},
          "source_column": {"type": "string", "minLength": 1},
          "source_value": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "annotation_impulse"}}},
            "then": {"required": ["source_annotation"]}
          },
          {
            "if": {"properties": {"kind": {"const": "bids_event_impulse"}}},
            "then": {"required": ["source_column", "source_value"]}
          }
        ],
        "additionalProperties": true
      }
    },
    "synchronization": {"type": "object"},
    "output": {"type": "object"},
    "validation": {"type": "object"},
    "license": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "source": {
            "anyOf": [
              {"required": ["files"]},
              {"required": ["file_url", "filename", "sha256"]}
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
