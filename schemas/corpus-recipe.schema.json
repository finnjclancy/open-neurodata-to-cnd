{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/finnjclancy/open-neurodata-to-cnd/schemas/corpus-recipe.schema.json",
  "title": "Open Neurodata to CND corpus recipe",
  "type": "object",
  "required": [
    "corpus_id",
    "corpus_version",
    "status",
    "inventory",
    "source",
    "layout"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "template_recipe": {"type": "string", "minLength": 1},
    "inventory": {
      "type": "object",
      "required": ["url", "canonical_sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["dataset_id", "provider", "version", "url"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "extension": {"type": "string", "minLength": 1},
        "participants_path": {"type": ["string", "null"]},
        "shared_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "recording_suffixes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "experiments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "task",
              "template_recipe",
              "paths",
              "primary_path",
              "metadata_path"
            ],
            "properties": {
              "task": {"type": "string", "minLength": 1},
              "template_recipe": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "primary_path": {"type": "string", "minLength": 1},
              "metadata_path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "oneOf": [
        {"required": ["task", "extension", "shared_paths", "recording_suffixes"]},
        {"required": ["experiments"]}
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"layout": {"required": ["task"]}}
      },
      "then": {"required": ["template_recipe"]}
    }
  ],
  "additionalProperties": false
}
